# Copia este archivo a .env.local y completa los valores reales.
# Nunca subas .env ni .env.local al repositorio (ya están en .gitignore).

# --- Base de datos ---
# Cadena de conexión de PostgreSQL. En local, si usas el docker-compose.yml incluido:
# postgresql://kyro:kyro@localhost:5432/kyro
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- NextAuth ---
# URL pública donde corre la app (http://localhost:3000 en local)
NEXTAUTH_URL="http://localhost:3000"
# Secreto para firmar sesiones JWT. Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Credenciales del admin (login en /admin/login) ---
# Email exacto que se compara en lib/auth.ts
ADMIN_EMAIL=""
# Hash bcrypt de la contraseña (NO la contraseña en texto plano).
# Genera uno con:
#   node -e "console.log(require('bcryptjs').hashSync('tu-password', 10))"
ADMIN_PASSWORD_HASH=""
